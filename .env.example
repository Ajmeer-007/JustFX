# Environment Variables Example for JustFX ICT/SMC Trading Analysis Dashboard
# Copy this file to .env and configure your local or cloud settings

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication Secret (Used to sign JWT session tokens)
# Generate a strong 32-byte secret for production (e.g., openssl rand -base64 32)
JWT_SECRET=justfx_trading_jwt_secret_development_key_replace_in_production

# Database Connection URL
# For local development with SQLite:
DATABASE_URL="file:./dev.db"
# For production deployment on Vercel with Neon/Supabase Postgres:
# DATABASE_URL="postgresql://user:password@ep-cool-project.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-cool-project.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional Market Data API Keys (Fallback feeds)
# Primary feeds (Binance public API & Yahoo Finance) require ZERO API keys.
# Optional backup feeds:
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

# MetaTrader 5 Bridge Secret (Optional local desktop sync)
MT5_BRIDGE_TOKEN=justfx_local_mt5_bridge_token_replace_me
